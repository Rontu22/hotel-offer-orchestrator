# Copy to infra/.env.aws and fill in. That file is gitignored.
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION=ap-south-1
export AWS_DEFAULT_REGION=ap-south-1

# Images the instance pulls. Both tags live in the same ECR repository; the
# deploy script pushes them together.
export BACKEND_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/hotel-offers-backend:latest
export SUPPLIER_IMAGE=<account>.dkr.ecr.ap-south-1.amazonaws.com/hotel-offers-backend:suppliers
