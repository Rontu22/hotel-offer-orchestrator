# Copy to .env before `docker compose up`. No third-party keys are needed.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal
# Published for local (non-Docker) runs of the supplier services.
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379
# Published for local (non-Docker) runs of the API and worker.
REDIS_PORT=6379
TEMPORAL_PORT=7233
CACHE_TTL_SECONDS=300

TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# The two supplier services: separate processes, each with its own database in
# the shared Postgres instance (supplier_a / supplier_b), created and seeded on
# first boot. The orchestrator reaches them over HTTP and nothing else.
SUPPLIER_A_PORT=4002
SUPPLIER_B_PORT=4003

# How slow each supplier pretends to be (ms), so the parallel fan-out is visible.
SUPPLIER_LATENCY_MS=150

# Allows the runtime supplier kill switch (PUT /api/suppliers/:id/availability).
# Set false for a real deployment: the endpoint is unauthenticated by design here.
ENABLE_FAULT_INJECTION=true

# Per-dependency budget in /health, matched to the activity's 5s fetch timeout so
# a busy host cannot report a working supplier as down. Raise on a small host.
HEALTH_PROBE_TIMEOUT_MS=5000

API_PORT=3001
WEB_PORT=3000
TEMPORAL_UI_PORT=8080
