        {
          "name": "Supplier A health (checks its own database)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{supplierAUrl}}/health",
              "host": [
                "{{supplierAUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Each supplier owns a Postgres database and reports on it independently of the orchestrator."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('identifies itself', () => pm.expect(body.supplier).to.eql('supplierA'));",
                  "pm.test('its database answered', () => pm.expect(body.status).to.eql('ok'));",
                  "// Liveness, not readiness: a switched-off supplier is still a healthy process.",
                  "pm.test('reports its availability flag', () => pm.expect(body.available).to.be.a('boolean'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier B health (checks its own database)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{supplierBUrl}}/health",
              "host": [
                "{{supplierBUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('identifies itself', () => pm.expect(body.supplier).to.eql('supplierB'));",
                  "pm.test('its database answered', () => pm.expect(body.status).to.eql('ok'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Supplier A availability flag lives in the supplier",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{supplierAUrl}}/admin/availability",
              "host": [
                "{{supplierAUrl}}"
              ],
              "path": [
                "admin",
                "availability"
              ]
            },
            "description": "The kill switch is the supplier's own state. /api/suppliers on the orchestrator just forwards here."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('owns its own flag', () => pm.expect(body).to.have.property('available'));",
                  "pm.test('agrees with the orchestrator', () => {",
                  "  pm.sendRequest(pm.collectionVariables.replaceIn('{{baseUrl}}/api/suppliers'), (err, res) => {",
                  "    if (!err) pm.expect(res.json().supplierA).to.eql(body.available);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ],
      "description": "Each supplier is its own service on its own port, reading its own Postgres database. These requests bypass the orchestrator entirely."
    },
