    {
      "name": "4. Simulate a supplier being down",
      "description": "Takes Supplier A offline at runtime, proves the workflow degrades to Supplier B, then restores it.",
      "item": [
        {
          "name": "Take Supplier A down",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers/supplierA/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suppliers",
                "supplierA",
                "availability"
              ],
              "query": []
            },
            "description": "Flips a Redis-backed kill switch and invalidates cached aggregates.",
            "body": {
              "mode": "raw",
              "raw": "{\"available\": false}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
