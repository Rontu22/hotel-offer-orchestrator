{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Set the `target` collection variable to 'ec2' or 'local' \u2014 that is the only value to change. It defaults to 'ec2', the deployed instance. baseUrl / supplierAUrl / supplierBUrl are derived from it before every request, so there are no separate environment files to keep in step.\n\n  ec2   : the deployed instance, hit directly on 4001/4002/4003 (default)\n  local : the stack from `cd infra && docker compose up -d`\n\nThe ec2 target deliberately bypasses CloudFront: the edge sets its own X-Cache header, which masks the API's X-Cache: HIT|MISS and defeats the Redis cache assertions. The supplier services are not routed through CloudFront either.\n\nNote the outage folder switches real suppliers off and on again on the deployed stack. It restores both at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "target",
      "value": "ec2",
      "type": "string",
      "description": "Where the collection points: 'ec2' (default, the deployed instance) or 'local'. Change this one value; the three URLs below are derived from it on every request."
    },
    {
      "key": "ec2Host",
      "value": "ec2-3-108-208-55.ap-south-1.compute.amazonaws.com",
      "type": "string",
      "description": "Public DNS of the instance. Terraform: `terraform output api_origin`."
    },
    {
      "key": "baseUrl",
      "value": "http://ec2-3-108-208-55.ap-south-1.compute.amazonaws.com:4001",
      "type": "string",
      "description": "Derived from target."
    },
    {
      "key": "supplierAUrl",
      "value": "http://ec2-3-108-208-55.ap-south-1.compute.amazonaws.com:4002",
      "type": "string",
      "description": "Derived from target."
    },
    {
      "key": "supplierBUrl",
      "value": "http://ec2-3-108-208-55.ap-south-1.compute.amazonaws.com:4003",
      "type": "string",
      "description": "Derived from target."
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "description": "The health endpoint reports Redis, Temporal and both suppliers.",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ],
              "query": []
            },
            "description": "No dependencies: a supplier outage must never mark the container dead."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Full health report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Includes a per-supplier probe with latency."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 while serviceable', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok or degraded', () => pm.expect(['ok','degraded']).to.include(body.status));",
                  "pm.test('reports redis and temporal', () => {",
                  "  pm.expect(body.redis.status).to.eql('up');",
                  "  pm.expect(body.temporal.status).to.eql('up');",
                  "});",
                  "pm.test('reports BOTH suppliers with latency', () => {",
                  "  pm.expect(body.suppliers).to.have.all.keys('supplierA', 'supplierB');",
                  "  pm.expect(body.suppliers.supplierA.latencyMs).to.be.a('number');",
                  "  pm.expect(body.suppliers.supplierB.latencyMs).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
