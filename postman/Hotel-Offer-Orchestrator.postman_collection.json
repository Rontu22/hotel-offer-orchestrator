                  "pm.test('200, not an error', () => pm.response.to.have.status(200));",
                  "pm.test('flags the degradation', () => pm.expect(pm.response.headers.get('X-Degraded-Suppliers')).to.eql('Supplier A'));",
                  "pm.test('every offer comes from Supplier B', () => pm.expect(body.every(o => o.supplier === 'Supplier B')).to.be.true);",
                  "pm.test('Holtin is still priced', () => pm.expect(body.find(o => o.name === 'Holtin').price).to.eql(5340));"
                ]
              }
