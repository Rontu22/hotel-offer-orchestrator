  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Single switch for where this collection points: 'local' or 'ec2'.",
          "// Everything else is derived, so there is one value to change, not three.",
          "const target = (pm.variables.get('target') || 'local').toLowerCase();",
          "",
          "const HOSTS = {",
          "  local: { host: 'localhost', apiPort: '3001' },",
          "  ec2:   { host: pm.variables.get('ec2Host'), apiPort: '4001' },",
          "};",
          "",
          "const { host, apiPort } = HOSTS[target] || HOSTS.local;",
          "if (!host) throw new Error(`No host for target '${target}' \u2014 set ec2Host.`);",
          "",
          "pm.collectionVariables.set('baseUrl', `http://${host}:${apiPort}`);",
          "pm.collectionVariables.set('supplierAUrl', `http://${host}:4002`);",
          "pm.collectionVariables.set('supplierBUrl', `http://${host}:4003`);"
        ]
      }
    }
  ]
