            "description": "Runs the Temporal workflow on a cache miss; cheapest offer per hotel name wins."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('returns offers', () => pm.expect(body.length).to.be.above(0));",
                  "pm.test('deduplicated by name', () => {",
                  "  const names = body.map(o => o.name);",
                  "  pm.expect(new Set(names).size).to.eql(names.length);",
                  "});",
                  "pm.test('response shape', () => body.forEach(o => pm.expect(o).to.have.all.keys('name','price','supplier','commissionPct')));",
                  "pm.test('cheapest supplier wins the overlap', () => {",
                  "  const holtin = body.find(o => o.name === 'Holtin');",
                  "  pm.expect(holtin).to.deep.include({ price: 5340, supplier: 'Supplier B' });",
                  "});",
                  "pm.test('both suppliers are represented', () => {",
                  "  pm.expect(body.some(o => o.supplier === 'Supplier A')).to.be.true;",
                  "  pm.expect(body.some(o => o.supplier === 'Supplier B')).to.be.true;",
                  "});",
                  "pm.collectionVariables.set('delhiCount', body.length);",
                  "pm.collectionVariables.set('delhiOffers', JSON.stringify(pm.response.json()));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Same city again \u2014 re-orchestrated, not replayed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            },
            "description": "Redis holds the price-scored set so ZRANGEBYSCORE does the filtering; it does not short-circuit the workflow. A repeated search runs the workflow again, so the prices quoted are never older than this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('same offers as the first run', () => {",
                  "  pm.expect(body).to.eql(JSON.parse(pm.collectionVariables.get('delhiOffers')));",
                  "});",
                  "// The cache header is gone: nothing may claim this was served from a cache.",
                  "pm.test('no cache hit is claimed', () => {",
                  "  pm.expect(pm.response.headers.get('X-Cache')).to.be.undefined;",
                  "});"
                ]
              }
            }
